          }
        ],
        "title": "formation"
      },
      {
        "id": "examples-in-context",
        "body": [
          {
            "en": "I was very ill yesterday.",
            "kind": "example",
            "note": [
              {
                "kind": "text",
                "text": "Vowel-final stem "
              },
              {
                "kind": "em",
                "children": [
                  {
                    "kind": "text",
                    "text": "hasta"
                  }
                ]
              },
              {
                "kind": "text",
                "text": " + buffer -y- + -dı + -m. First-hand knowledge → -(y)DI."
              }
            ],
            "target": [
              {
                "kind": "text",
                "text": "Dün çok "
              },
              {
                "kind": "hilite",
                "children": [
                  {
                    "kind": "text",
                    "text": "hastaydım"
                  }
                ]
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          },
          {
            "en": "We were students back then.",
            "kind": "example",
            "note": [
              {
                "kind": "text",
                "text": "Vowel-final stem "
              },
              {
                "kind": "em",
                "children": [
                  {
                    "kind": "text",
                    "text": "öğrenci"
                  }
                ]
              },
              {
                "kind": "text",
                "text": " + -y- + -di + -k. First person plural Group 1 ending."
              }
            ],
            "target": [
              {
                "kind": "text",
                "text": "Biz o zaman "
              },
              {
                "kind": "hilite",
                "children": [
                  {
                    "kind": "text",
                    "text": "öğrenciydik"
                  }
                ]
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          },
          {
            "en": "There used to be a restaurant here.",
            "kind": "example",
            "note": [
              {
                "kind": "text",
                "text": "Past existence: "
              },
              {
                "kind": "em",
                "children": [
                  {
                    "kind": "text",
                    "text": "var"
                  }
                ]
              },
              {
                "kind": "text",
                "text": " + -dı. No personal ending needed — third person is zero-marked."
              }
            ],
            "target": [
              {
                "kind": "text",
                "text": "Eskiden burada bir lokanta "
              },
              {
                "kind": "hilite",
                "children": [
                  {
                    "kind": "text",
