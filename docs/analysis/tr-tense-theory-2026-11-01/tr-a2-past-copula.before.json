                  }
                ]
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          },
          {
            "en": "She was apparently tired, so she didn't come.",
            "kind": "example",
            "note": [
              {
                "kind": "text",
                "text": "Consonant-final stem "
              },
              {
                "kind": "em",
                "children": [
                  {
                    "kind": "text",
                    "text": "yorgun"
                  }
                ]
              },
              {
                "kind": "text",
                "text": " + -muş (no buffer needed). Evidential: the speaker infers or was told about her tiredness."
              }
            ],
            "target": [
              {
                "kind": "hilite",
                "children": [
                  {
                    "kind": "text",
                    "text": "Yorgunmuş"
                  }
                ]
              },
              {
