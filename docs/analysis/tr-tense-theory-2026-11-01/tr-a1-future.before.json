      {
        "id": "common-pitfalls",
        "body": [
          {
            "kind": "list",
            "items": [
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Forgetting k → ğ before vowel-initial endings."
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "callout",
                  "variant": "warn",
                  "children": [
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "✗ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "gelecekiz"
                            }
                          ]
                        },
                        {
                          "kind": "text",
                          "text": "   ✓ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "geleceğiz"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "Whenever a vowel-initial personal ending (-im, -iz) follows the suffix, the final "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "-k"
                            }
