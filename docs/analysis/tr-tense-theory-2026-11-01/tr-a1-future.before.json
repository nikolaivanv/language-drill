                              "kind": "text",
                              "text": "okuyacak"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "Turkish does not allow two vowels to meet across a morpheme boundary. Any vowel-final stem requires the buffer consonant "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "-y-"
                            }
                          ]
                        },
                        {
                          "kind": "text",
                          "text": " before -(y)AcAk."
                        }
                      ]
                    }
                  ]
                }
              ],
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Mis-harmonising the negative -mA-."
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "callout",
                  "variant": "warn",
                  "children": [
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "✗ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "gelmayacak"
                            }
                          ]
                        },
                        {
                          "kind": "text",
                          "text": "   ✓ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "gelmeyecek"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "The vowel in "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "-mA-"
                            }
                          ]
                        },
                        {
                          "kind": "text",
