                      ]
                    }
                  ]
                },
                {
                  "kind": "callout",
                  "variant": "warn",
                  "children": [
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "✗ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "okuacak"
                            }
                          ]
                        },
                        {
                          "kind": "text",
                          "text": "   ✓ "
