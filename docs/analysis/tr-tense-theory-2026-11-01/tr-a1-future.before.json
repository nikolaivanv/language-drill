                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "-ğ"
                            }
                          ]
                        },
                        {
                          "kind": "text",
                          "text": ". This applies to both positive and negative forms."
                        }
                      ]
                    }
                  ]
                }
              ],
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Using -(I)yor for planned future events."
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "callout",
                  "variant": "warn",
                  "children": [
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "✗ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "Yarın geliyorum."
                            }
                          ]
                        },
                        {
                          "kind": "text",
                          "text": "   ✓ "
                        },
                        {
                          "kind": "mono",
                          "children": [
                            {
                              "kind": "text",
                              "text": "Yarın geleceğim."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "kind": "paragraph",
                      "text": [
                        {
                          "kind": "text",
                          "text": "Unlike English, Turkish does not conventionally use the present continuous to express future plans. Use -(y)AcAk when the event has not yet happened."
                        }
                      ]
                    }
                  ]
                }
              ],
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Dropping the -y- buffer after a vowel-final stem."
