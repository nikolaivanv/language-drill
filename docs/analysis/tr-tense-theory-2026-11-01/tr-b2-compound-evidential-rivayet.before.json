              }
            ],
            "target": [
              {
                "kind": "text",
                "text": "Yarın "
              },
              {
                "kind": "hilite",
                "children": [
                  {
                    "kind": "text",
                    "text": "gelecekmiş"
                  }
                ]
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          },
          {
            "en": "According to her, we ought to work harder.",
            "kind": "example",
            "note": [
              {
                "kind": "text",
                "text": "Necessity + evidential copula + 1st plural: "
              },
              {
                "kind": "mono",
                "children": [
                  {
                    "kind": "text",
                    "text": "çalış-malı-ymış-ız"
                  }
                ]
              },
              {
                "kind": "text",
                "text": ". The glide "
              },
              {
                "kind": "em",
                "children": [
                  {
                    "kind": "text",
                    "text": "-y-"
                  }
                ]
              },
              {
                "kind": "text",
                "text": " links the vowel-final "
              },
              {
                "kind": "em",
                "children": [
                  {
                    "kind": "text",
                    "text": "-mAlI"
                  }
                ]
              },
              {
                "kind": "text",
                "text": " to the copula."
              }
            ],
            "target": [
              {
                "kind": "text",
                "text": "Ona göre daha çok "
              },
              {
                "kind": "hilite",
                "children": [
                  {
                    "kind": "text",
                    "text": "çalışmalıymışız"
                  }
                ]
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          }
        ],
        "title": "examples in context"
      },
      {
        "id": "common-pitfalls",
        "body": [
          {
            "kind": "list",
            "items": [
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Attaching -(y)mIş to -DI."
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " The simple past suffix "
                    },
                    {
                      "kind": "hilite",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-DI"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " cannot host the evidential copula. "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "*Geldimiş"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " is not a valid form. To report a past event you did not witness, use the finite evidential past "
                    },
                    {
                      "kind": "hilite",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-mIş"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " directly on the stem: "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "gelmiş"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": "."
                    }
                  ]
                }
              ],
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Double-marking evidentiality."
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " Because "
                    },
                    {
                      "kind": "hilite",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-mIş"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " is already evidential, stacking it twice — "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "*geliyormuşmuş"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " — is ungrammatical. One instance of -(y)mIş is always sufficient."
                    }
                  ]
                }
              ],
              [
                {
                  "kind": "paragraph",
                  "text": [
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "Using group-1 person endings after -(y)mIş."
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " After the evidential copula, person is marked with "
                    },
                    {
                      "kind": "strong",
                      "children": [
                        {
                          "kind": "text",
                          "text": "group-2 endings"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " (the same set used after "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-mIş"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " and "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-DI"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": "). The group-1 first-person singular ending "
                    },
                    {
                      "kind": "hilite",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-m"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " is wrong here: "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "*geliyormuşdum"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " is incorrect. The correct form is "
                    },
                    {
                      "kind": "em",
                      "children": [
                        {
                          "kind": "text",
                          "text": "geliyormuşum"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": " (group-2: "
                    },
                    {
                      "kind": "hilite",
                      "children": [
                        {
                          "kind": "text",
                          "text": "-(y)Im"
                        }
                      ]
                    },
                    {
                      "kind": "text",
                      "text": ")."
                    }
                  ]
                }
              ]
            ]
          }
        ],
        "title": "common pitfalls"
      }
    ],
    "subtitle": "Adding hearsay or inference to any tense with -(y)mIş"
  }
}