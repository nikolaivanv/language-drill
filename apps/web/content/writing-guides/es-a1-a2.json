{
  "id": "es-a1-a2",
  "title": "Writing a paragraph in Spanish",
  "subtitle": "How to write a short paragraph about everyday life at A1–A2 — what the grader looks for and how to deliver it.",
  "cefr": "A1–A2",
  "sections": [
    {
      "id": "what-is-graded",
      "title": "what the grader looks for",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Every attempt is scored on four criteria. You get a score for each one, plus corrections of your sentences. Knowing the four criteria tells you where to spend your effort."
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Task"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — did you answer the question, include every required element, and stay inside the word range?"
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Coherence"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — do your sentences come in a clear order, joined with simple connectors such as \"and\", \"but\" and \"because\"?"
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Vocabulary"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — did you use words that fit the topic, spelled correctly, without repeating the same word again and again?"
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Grammar"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — are your verb forms, agreement and word order correct?"
                  }
                ]
              }
            ]
          ]
        },
        {
          "kind": "callout",
          "children": [
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "A1:"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " 30–60 words, 10 minutes on the timer. "
                },
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "A2:"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " 60–100 words, 15 minutes on the timer."
                }
              ]
            },
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "text",
                  "text": "Writing fewer words than the minimum costs you on Task, even if every sentence is correct."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "paragraph-shape",
      "title": "the shape of a paragraph",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "A good short paragraph has three parts: an "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "opening sentence"
                }
              ]
            },
            {
              "kind": "text",
              "text": " that says what you are writing about, "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "two or three supporting points"
                }
              ]
            },
            {
              "kind": "text",
              "text": " (each with a detail, a reason or an example), and a "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "closing sentence"
                }
              ]
            },
            {
              "kind": "text",
              "text": " that rounds it off."
            }
          ]
        },
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Here is a model paragraph on the topic "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "\"Mi fin de semana\""
                }
              ]
            },
            {
              "kind": "text",
              "text": " (my weekend), one sentence at a time. It is 82 words — A2 length. At A1, write the opening, two supporting sentences and the closing."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Normalmente, mis fines de semana son tranquilos "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "pero"
                }
              ]
            },
            {
              "kind": "text",
              "text": " muy agradables."
            }
          ],
          "en": "Usually, my weekends are quiet but very pleasant.",
          "note": [
            {
              "kind": "text",
              "text": "Opening sentence: says what the paragraph is about."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "El sábado por la mañana, "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "primero"
                }
              ]
            },
            {
              "kind": "text",
              "text": " voy al mercado con mi hermana "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "y"
                }
              ]
            },
            {
              "kind": "text",
              "text": " compramos fruta "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "y"
                }
              ]
            },
            {
              "kind": "text",
              "text": " pan."
            }
          ],
          "en": "On Saturday morning, first I go to the market with my sister and we buy fruit and bread.",
          "note": [
            {
              "kind": "text",
              "text": "Supporting point 1: what you do, with a detail."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "Después"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", comemos en casa de mis padres "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "porque"
                }
              ]
            },
            {
              "kind": "text",
              "text": " mi madre cocina muy bien."
            }
          ],
          "en": "Afterwards, we eat at my parents' house because my mother cooks very well.",
          "note": [
            {
              "kind": "text",
              "text": "Adds a reason with "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "porque"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Por la tarde, a veces juego al fútbol con mis amigos en el parque."
            }
          ],
          "en": "In the afternoon, I sometimes play football with my friends in the park.",
          "note": [
            {
              "kind": "text",
              "text": "Supporting point 2."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "El domingo descanso: leo un libro, veo una película "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "y también"
                }
              ]
            },
            {
              "kind": "text",
              "text": " llamo a mi abuela."
            }
          ],
          "en": "On Sunday I rest: I read a book, watch a film and also call my grandmother.",
          "note": [
            {
              "kind": "text",
              "text": "Supporting point 3: a short list of activities."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Me gustan mucho mis fines de semana "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "porque"
                }
              ]
            },
            {
              "kind": "text",
              "text": " tengo tiempo para mi familia."
            }
          ],
          "en": "I like my weekends a lot because I have time for my family.",
          "note": [
            {
              "kind": "text",
              "text": "Closing sentence: your feeling about the topic, with a reason."
            }
          ]
        },
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Notice that each sentence does one job, and the highlighted connectors link them. Time expressions ("
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "el sábado"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "por la tarde"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "el domingo"
                }
              ]
            },
            {
              "kind": "text",
              "text": ") also give the paragraph a clear order."
            }
          ]
        }
      ]
    },
    {
      "id": "connectors",
      "title": "connectors",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Connectors are the small words that show how one idea relates to the next. At this level, a handful used correctly is enough."
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Adding"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "y"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "también"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Tengo un perro "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "y también"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " tengo dos gatos."
                  }
                ],
                "en": "I have a dog and I also have two cats."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Contrasting"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "pero"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "sino"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " (after "
                  },
                  {
                    "kind": "em",
                    "children": [
                      {
                        "kind": "text",
                        "text": "no"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ": "
                  },
                  {
                    "kind": "em",
                    "children": [
                      {
                        "kind": "text",
                        "text": "No es grande, sino pequeño"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ")"
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Mi piso es pequeño, "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "pero"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " es muy bonito."
                  }
                ],
                "en": "My flat is small, but it is very nice."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Cause"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "porque"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "por eso"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " (= that's why: "
                  },
                  {
                    "kind": "em",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Tengo sueño, por eso me acuesto temprano"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ")"
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Estudio español "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "porque"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " quiero viajar a México."
                  }
                ],
                "en": "I study Spanish because I want to travel to Mexico."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Giving an example"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "por ejemplo"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "como"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " (= such as, before a noun: "
                  },
                  {
                    "kind": "em",
                    "children": [
                      {
                        "kind": "text",
                        "text": "deportes como el tenis"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ")"
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Me gusta mucho el deporte, "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "por ejemplo"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", el tenis y la natación."
                  }
                ],
                "en": "I really like sport, for example tennis and swimming."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Sequencing and concluding"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "primero"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "después"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "por último"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Primero"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " desayuno, "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "después"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " me ducho y "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "por último"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " salgo de casa."
                  }
                ],
                "en": "First I have breakfast, then I shower and finally I leave the house."
              }
            ]
          ]
        },
        {
          "kind": "callout",
          "variant": "warn",
          "children": [
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "Watch the spelling."
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " "
                },
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "porque"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " (because) is one word without an accent; "
                },
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "¿por qué?"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " (why?) is two words with an accent."
                }
              ]
            },
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "y"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " becomes "
                },
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "e"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " before a word starting with the sound "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "i"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " (spelled "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "i-"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " or "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "hi-"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": "): "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "padres e hijos"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ", "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "español e inglés"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ". But: "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "agua y hielo"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " ("
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "hie-"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " is not an \"i\" sound)."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "register",
      "title": "informal or formal",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Spanish has two ways to say \"you\". Use "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "tú"
                }
              ]
            },
            {
              "kind": "text",
              "text": " with friends, family and people your age; use "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "usted"
                }
              ]
            },
            {
              "kind": "text",
              "text": " with older people you don't know, officials, and in formal letters and emails. The verb changes too: with "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "usted"
                }
              ]
            },
            {
              "kind": "text",
              "text": " it takes the same form as "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "él"
                }
              ]
            },
            {
              "kind": "text",
              "text": " / "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "ella"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "¿Tienes tiempo el sábado?"
            }
          ],
          "en": "Do you have time on Saturday?",
          "note": [
            {
              "kind": "text",
              "text": "Informal: "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "tú tienes"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "¿Tiene usted tiempo el sábado?"
            }
          ],
          "en": "Do you have time on Saturday?",
          "note": [
            {
              "kind": "text",
              "text": "Formal: "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "usted tiene"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Pick one at the start and keep it to the end. Letters and messages also open and close differently:"
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Querida Ana:"
            }
          ],
          "en": "Dear Ana,",
          "note": [
            {
              "kind": "text",
              "text": "Informal opening. Spanish uses a colon after the greeting. For a man: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "Querido Pablo:"
                }
              ]
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Un abrazo,"
            }
          ],
          "en": "Love / Best wishes (literally \"a hug\"),",
          "note": [
            {
              "kind": "text",
              "text": "Informal closing."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Estimado señor López:"
            }
          ],
          "en": "Dear Mr López,",
          "note": [
            {
              "kind": "text",
              "text": "Formal opening. For a woman: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "Estimada señora López:"
                }
              ]
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Atentamente,"
            }
          ],
          "en": "Yours sincerely,",
          "note": [
            {
              "kind": "text",
              "text": "Formal closing."
            }
          ]
        }
      ]
    },
    {
      "id": "task-and-length",
      "title": "the task and the word count",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Most prompts list "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "required elements"
                }
              ]
            },
            {
              "kind": "text",
              "text": " — things your text must mention. The grader checks each one. Make every element visibly present: give it its own sentence, and use the element's own key word so it cannot be missed."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "El domingo, normalmente visito a mis abuelos."
            }
          ],
          "en": "On Sunday, I usually visit my grandparents.",
          "note": [
            {
              "kind": "text",
              "text": "Required element \"what you do on Sunday\" — the sentence starts with the key word "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "domingo"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Plan first."
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Before you write, list the required elements and give each one a sentence. Add your opening and closing sentence to the plan."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Write simply."
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Short, correct sentences score better than long sentences with mistakes."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Count your words"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " before you submit, and compare with the range for your level."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Too short?"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Add a reason (with \"because\") or an example to one of your points."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Too long?"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Cut repetition first — sentences that say the same thing twice — not a required element."
                  }
                ]
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "common-mistakes",
      "title": "common mistakes",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "These are the errors the grader flags most often at A1–A2. Each example shows the "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "correct"
                }
              ]
            },
            {
              "kind": "text",
              "text": " sentence; the wrong version is in the note."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Estoy cansado."
            }
          ],
          "en": "I am tired.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Soy cansado*. Use "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "estar"
                }
              ]
            },
            {
              "kind": "text",
              "text": " for how someone feels or is at the moment (tired, happy, ill) and for location; "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "ser"
                }
              ]
            },
            {
              "kind": "text",
              "text": " for what someone or something is (identity, nationality, character, profession)."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Mi casa es pequeña y bonita."
            }
          ],
          "en": "My house is small and pretty.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Mi casa es pequeño y bonito*. Adjectives agree with the noun: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "casa"
                }
              ]
            },
            {
              "kind": "text",
              "text": " is feminine."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Mis hermanas son altas."
            }
          ],
          "en": "My sisters are tall.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Mis hermanas son alta*. Plural nouns need plural adjectives."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Mi mamá está en el café."
            }
          ],
          "en": "My mum is at the café.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Mi mama esta en el cafe*. Accents are part of the spelling: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "esta"
                }
              ]
            },
            {
              "kind": "text",
              "text": " means \"this\", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "está"
                }
              ]
            },
            {
              "kind": "text",
              "text": " means \"is\"."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Me gustan los perros."
            }
          ],
          "en": "I like dogs.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Me gusta los perros*. "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "Gustar"
                }
              ]
            },
            {
              "kind": "text",
              "text": " agrees with the thing you like: plural thing, "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "gustan"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Tengo veinte años."
            }
          ],
          "en": "I am twenty years old.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Soy veinte años*. Spanish uses "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "tener"
                }
              ]
            },
            {
              "kind": "text",
              "text": " for age."
            }
          ]
        }
      ]
    },
    {
      "id": "checklist",
      "title": "before you submit",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Run through this list before you press submit:"
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "Every required element is present, each in its own sentence."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "The word count is inside the range for your level."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "There is an opening sentence and a closing sentence."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "You used at least "
                  },
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "2 connectors"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " (for example \"and\", \"but\", \"because\")."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "The register is consistent from start to finish — you did not switch between informal and formal."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "You reread the text once, looking only for the mistakes listed in the previous section."
                  }
                ]
              }
            ]
          ]
        }
      ]
    }
  ]
}
