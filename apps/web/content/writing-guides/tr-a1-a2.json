{
  "id": "tr-a1-a2",
  "title": "Writing a paragraph in Turkish",
  "subtitle": "How to write a short paragraph about everyday life at A1–A2 — what the grader looks for and how to deliver it.",
  "cefr": "A1–A2",
  "sections": [
    {
      "id": "what-is-graded",
      "title": "what the grader looks for",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Every attempt is scored on four criteria. You get a score for each one, plus corrections of your sentences. Knowing the four criteria tells you where to spend your effort."
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Task"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — did you answer the question, include every required element, and stay inside the word range?"
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Coherence"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — do your sentences come in a clear order, joined with simple connectors such as \"and\", \"but\" and \"because\"?"
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Vocabulary"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — did you use words that fit the topic, spelled correctly, without repeating the same word again and again?"
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Grammar"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — are your verb forms, agreement and word order correct?"
                  }
                ]
              }
            ]
          ]
        },
        {
          "kind": "callout",
          "children": [
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "A1:"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " 30–60 words, 10 minutes on the timer. "
                },
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "A2:"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " 60–100 words, 15 minutes on the timer."
                }
              ]
            },
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "text",
                  "text": "Writing fewer words than the minimum costs you on Task, even if every sentence is correct."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "paragraph-shape",
      "title": "the shape of a paragraph",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "A good short paragraph has three parts: an "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "opening sentence"
                }
              ]
            },
            {
              "kind": "text",
              "text": " that says what you are writing about, "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "two or three supporting points"
                }
              ]
            },
            {
              "kind": "text",
              "text": " (each with a detail, a reason or an example), and a "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "closing sentence"
                }
              ]
            },
            {
              "kind": "text",
              "text": " that rounds it off."
            }
          ]
        },
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Here is a model paragraph on the topic "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "\"Hafta sonum\""
                }
              ]
            },
            {
              "kind": "text",
              "text": " (my weekend), one sentence at a time. It is 67 words — A2 length. At A1, write the opening, two supporting sentences and the closing."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Hafta sonum genellikle çok sakin geçer."
            }
          ],
          "en": "My weekend is usually very quiet.",
          "note": [
            {
              "kind": "text",
              "text": "Opening sentence: says what the paragraph is about."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Cumartesi sabahı "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "önce"
                }
              ]
            },
            {
              "kind": "text",
              "text": " kahvaltı yaparım, "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "sonra"
                }
              ]
            },
            {
              "kind": "text",
              "text": " annemle pazara giderim."
            }
          ],
          "en": "On Saturday morning I first have breakfast, then I go to the market with my mother.",
          "note": [
            {
              "kind": "text",
              "text": "Supporting point 1. Each clause ends with its verb: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "yaparım"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "giderim"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Pazardan meyve "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "ve"
                }
              ]
            },
            {
              "kind": "text",
              "text": " sebze alırız, "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "çünkü"
                }
              ]
            },
            {
              "kind": "text",
              "text": " orada her şey taze ve ucuz."
            }
          ],
          "en": "We buy fruit and vegetables at the market, because everything there is fresh and cheap.",
          "note": [
            {
              "kind": "text",
              "text": "Adds a reason with "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "çünkü"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Öğleden sonra arkadaşlarımla parkta futbol oynarım; küçük kardeşim "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "de"
                }
              ]
            },
            {
              "kind": "text",
              "text": " bazen bizimle gelir."
            }
          ],
          "en": "In the afternoon I play football with my friends in the park; my little brother sometimes comes with us too.",
          "note": [
            {
              "kind": "text",
              "text": "Supporting point 2. "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "de"
                }
              ]
            },
            {
              "kind": "text",
              "text": " (too) is a separate word."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Pazar günü evde dinlenirim, kitap okurum "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "ve"
                }
              ]
            },
            {
              "kind": "text",
              "text": " bazen film izlerim."
            }
          ],
          "en": "On Sunday I rest at home, read a book and sometimes watch a film.",
          "note": [
            {
              "kind": "text",
              "text": "Supporting point 3: a short list of activities."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Akşam ailemle birlikte yemek yeriz ve sohbet ederiz."
            }
          ],
          "en": "In the evening we eat together as a family and chat.",
          "note": [
            {
              "kind": "text",
              "text": "Rounds off the day."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Hafta sonumu çok seviyorum, "
            },
            {
              "kind": "hilite",
              "children": [
                {
                  "kind": "text",
                  "text": "ama"
                }
              ]
            },
            {
              "kind": "text",
              "text": " her zaman çok çabuk bitiyor!"
            }
          ],
          "en": "I love my weekend, but it always ends too quickly!",
          "note": [
            {
              "kind": "text",
              "text": "Closing sentence: your feeling about the topic."
            }
          ]
        },
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Notice that each sentence does one job, and the highlighted connectors link them. Time expressions ("
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "cumartesi sabahı"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "öğleden sonra"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "pazar günü"
                }
              ]
            },
            {
              "kind": "text",
              "text": ") give the paragraph a clear order. ("
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "Pazar"
                }
              ]
            },
            {
              "kind": "text",
              "text": " means both \"Sunday\" and \"market\" — context makes it clear.)"
            }
          ]
        }
      ]
    },
    {
      "id": "connectors",
      "title": "connectors",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Connectors are the small words that show how one idea relates to the next. At this level, a handful used correctly is enough."
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Adding"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "ve"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "de"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " / "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "da"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Annem öğretmen, babam "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "da"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " öğretmen."
                  }
                ],
                "en": "My mother is a teacher, and my father is a teacher too."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Contrasting"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "ama"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "fakat"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Evim küçük "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "ama"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " çok rahat."
                  }
                ],
                "en": "My home is small but very comfortable."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Cause"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "çünkü"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Bugün evde kalıyorum, "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "çünkü"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " hastayım."
                  }
                ],
                "en": "I am staying at home today, because I am ill."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Giving an example"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "mesela"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "örneğin"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "text",
                    "text": "Bazı sporları çok severim, "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "örneğin"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " yüzmeyi ve tenisi."
                  }
                ],
                "en": "I really like some sports, for example swimming and tennis."
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Sequencing and concluding"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " — "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "önce"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "sonra"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": ", "
                  },
                  {
                    "kind": "mono",
                    "children": [
                      {
                        "kind": "text",
                        "text": "en sonunda"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "example",
                "target": [
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Önce"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " duş alırım, "
                  },
                  {
                    "kind": "hilite",
                    "children": [
                      {
                        "kind": "text",
                        "text": "sonra"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " kahvaltı yaparım."
                  }
                ],
                "en": "First I have a shower, then I have breakfast."
              }
            ]
          ]
        },
        {
          "kind": "callout",
          "variant": "warn",
          "children": [
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "`de` / `da` (too, also) is a separate word."
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " It follows vowel harmony: "
                },
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "de"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " after e, i, ö, ü ("
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "ben de"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ", "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "Ali de"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ", "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "kardeşim de"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ") and "
                },
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "da"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " after a, ı, o, u ("
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "babam da"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ", "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "o da"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ")."
                }
              ]
            },
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "text",
                  "text": "Don't confuse it with the locative suffix "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "-de / -da"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " (at, in), which is written "
                },
                {
                  "kind": "strong",
                  "children": [
                    {
                      "kind": "text",
                      "text": "attached"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": ": "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "evde"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " (at home). Both can appear together: "
                },
                {
                  "kind": "em",
                  "children": [
                    {
                      "kind": "text",
                      "text": "Ben de evdeyim."
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " — \"I am at home too.\""
                }
              ]
            },
            {
              "kind": "paragraph",
              "text": [
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "ama"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " and "
                },
                {
                  "kind": "mono",
                  "children": [
                    {
                      "kind": "text",
                      "text": "çünkü"
                    }
                  ]
                },
                {
                  "kind": "text",
                  "text": " start a new clause, but the verb still comes at the end of each clause."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "register",
      "title": "informal or formal",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Turkish has two ways to say \"you\". Use "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "sen"
                }
              ]
            },
            {
              "kind": "text",
              "text": " with friends, family and children; use "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "siz"
                }
              ]
            },
            {
              "kind": "text",
              "text": " with adults you do not know, at work and in formal letters (siz is also the plural \"you\"). The verb ending changes: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "-sın"
                }
              ]
            },
            {
              "kind": "text",
              "text": " for sen, "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "-sınız"
                }
              ]
            },
            {
              "kind": "text",
              "text": " for siz (with vowel harmony: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "-sin / -siniz"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "-sun / -sunuz"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "-sün / -sünüz"
                }
              ]
            },
            {
              "kind": "text",
              "text": ")."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Cumartesi müsait misin?"
            }
          ],
          "en": "Are you free on Saturday?",
          "note": [
            {
              "kind": "text",
              "text": "Informal: "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "sen"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Cumartesi müsait misiniz?"
            }
          ],
          "en": "Are you free on Saturday?",
          "note": [
            {
              "kind": "text",
              "text": "Formal: "
            },
            {
              "kind": "mono",
              "children": [
                {
                  "kind": "text",
                  "text": "siz"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Pick one at the start and keep it to the end. Letters and messages also open and close differently:"
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Sevgili Ayşe,"
            }
          ],
          "en": "Dear Ayşe,",
          "note": [
            {
              "kind": "text",
              "text": "Informal opening. Also simply: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "Merhaba Ayşe,"
                }
              ]
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Görüşmek üzere,"
            }
          ],
          "en": "See you soon,",
          "note": [
            {
              "kind": "text",
              "text": "Informal closing. Also: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "Sevgiler,"
                }
              ]
            },
            {
              "kind": "text",
              "text": " (love)."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Sayın Yetkili,"
            }
          ],
          "en": "Dear Sir or Madam,",
          "note": [
            {
              "kind": "text",
              "text": "Formal opening when you don't know the name (literally \"dear official\")."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Saygılarımla,"
            }
          ],
          "en": "Yours sincerely,",
          "note": [
            {
              "kind": "text",
              "text": "Formal closing (literally \"with my respects\")."
            }
          ]
        }
      ]
    },
    {
      "id": "task-and-length",
      "title": "the task and the word count",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Most prompts list "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "required elements"
                }
              ]
            },
            {
              "kind": "text",
              "text": " — things your text must mention. The grader checks each one. Make every element visibly present: give it its own sentence, and use the element's own key word so it cannot be missed."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Pazar günü ailemle kahvaltı yaparım."
            }
          ],
          "en": "On Sunday I have breakfast with my family.",
          "note": [
            {
              "kind": "text",
              "text": "Required element \"what you do on Sunday\" — the sentence starts with the key word "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "pazar günü"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Plan first."
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Before you write, list the required elements and give each one a sentence. Add your opening and closing sentence to the plan."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Write simply."
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Short, correct sentences score better than long sentences with mistakes."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Count your words"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " before you submit, and compare with the range for your level."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Too short?"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Add a reason (with \"because\") or an example to one of your points."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "Too long?"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " Cut repetition first — sentences that say the same thing twice — not a required element."
                  }
                ]
              }
            ]
          ]
        }
      ]
    },
    {
      "id": "common-mistakes",
      "title": "common mistakes",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "These are the errors the grader flags most often at A1–A2. Each example shows the "
            },
            {
              "kind": "strong",
              "children": [
                {
                  "kind": "text",
                  "text": "correct"
                }
              ]
            },
            {
              "kind": "text",
              "text": " sentence; the wrong version is in the note."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Evde ve okulda Türkçe konuşurum."
            }
          ],
          "en": "I speak Turkish at home and at school.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Evda ve okulde*. Suffix vowels follow the last vowel of the word: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "ev → evde"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "okul → okulda"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Kitabımı evde unuttum."
            }
          ],
          "en": "I forgot my book at home.",
          "note": [
            {
              "kind": "text",
              "text": "not: *Kitapımı*. Many nouns ending in "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "p, ç, t, k"
                }
              ]
            },
            {
              "kind": "text",
              "text": " soften before a vowel suffix: "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "kitap → kitabım"
                }
              ]
            },
            {
              "kind": "text",
              "text": ", "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "çocuk → çocuğum"
                }
              ]
            },
            {
              "kind": "text",
              "text": "."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Her sabah kahve içerim."
            }
          ],
          "en": "I drink coffee every morning.",
          "note": [
            {
              "kind": "text",
              "text": "not: *İçerim kahve her sabah*. The verb comes at the end of the sentence."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "Sen de geliyor musun?"
            }
          ],
          "en": "Are you coming too?",
          "note": [
            {
              "kind": "text",
              "text": "not: *Sen de geliyormusun?* The question particle "
            },
            {
              "kind": "em",
              "children": [
                {
                  "kind": "text",
                  "text": "mı / mi / mu / mü"
                }
              ]
            },
            {
              "kind": "text",
              "text": " is written as a separate word."
            }
          ]
        },
        {
          "kind": "example",
          "target": [
            {
              "kind": "text",
              "text": "İki kardeşim var."
            }
          ],
          "en": "I have two siblings.",
          "note": [
            {
              "kind": "text",
              "text": "not: *İki kardeşlerim var*. After a number, the noun stays singular."
            }
          ]
        }
      ]
    },
    {
      "id": "checklist",
      "title": "before you submit",
      "body": [
        {
          "kind": "paragraph",
          "text": [
            {
              "kind": "text",
              "text": "Run through this list before you press submit:"
            }
          ]
        },
        {
          "kind": "list",
          "items": [
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "Every required element is present, each in its own sentence."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "The word count is inside the range for your level."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "There is an opening sentence and a closing sentence."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "You used at least "
                  },
                  {
                    "kind": "strong",
                    "children": [
                      {
                        "kind": "text",
                        "text": "2 connectors"
                      }
                    ]
                  },
                  {
                    "kind": "text",
                    "text": " (for example \"and\", \"but\", \"because\")."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "The register is consistent from start to finish — you did not switch between informal and formal."
                  }
                ]
              }
            ],
            [
              {
                "kind": "paragraph",
                "text": [
                  {
                    "kind": "text",
                    "text": "You reread the text once, looking only for the mistakes listed in the previous section."
                  }
                ]
              }
            ]
          ]
        }
      ]
    }
  ]
}
